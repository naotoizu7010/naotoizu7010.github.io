---
/* ----------------------------------------------------------------
   src/pages/researcher.astro
   Coming Soon ページ。
   - 5秒後に / へ自動リダイレクト
   - JS無効でも meta refresh で同等の挙動
   ---------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
---

<Base
  title="Researcher — 準備中 / Naoto Oizumi"
  description="研究者向けのプロフィールページは準備中です。"
>
  <meta http-equiv="refresh" content="5;url=/" slot="head" />
  <main class="cs-root">
    <div class="cs-card">
      <div class="cs-eyebrow">FOR RESEARCHERS · /researcher</div>
      <h1 class="cs-title">
        <span class="cs-title-jp">準備中です。</span>
        <span class="cs-title-en">Coming soon.</span>
      </h1>
      <p class="cs-body">
        研究者向けのフォーマルなプロフィールページを準備しています。<br />
        業績・所属・論文・査読歴などをまとめて公開予定です。
      </p>
      <p class="cs-redirect">
        <span class="cs-redirect-dot"></span>
        5 秒後にトップへ移動します
      </p>
      <a href="/" class="cs-cta">いますぐトップへ →</a>
    </div>
  </main>
</Base>

<script>
  // 5秒後に / へリダイレクト (meta refresh のフォールバック付き)
  setTimeout(() => {
    window.location.replace('/');
  }, 5000);
</script>

<style>
  :root {
    --cs-fg: #0a0f1f;
    --cs-fg-mute: #6a7286;
    --cs-line: #dde2ec;
    --cs-bg: #f7f8fb;
    --cs-paper: #ffffff;
    --cs-red: #e5374b;
    --cs-blue: #2a56f0;
  }
  :global(html[data-pre-theme='dark']) {
    --cs-fg: #eceffb;
    --cs-fg-mute: #7782a0;
    --cs-line: #1a1f35;
    --cs-bg: #060814;
    --cs-paper: #0b0f22;
    --cs-red: #ff4e62;
    --cs-blue: #5a7cff;
  }

  .cs-root {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--cs-bg);
    color: var(--cs-fg);
    background-image:
      linear-gradient(rgba(10, 15, 31, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 15, 31, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    font-family: 'Inter', 'Noto Sans JP', system-ui, sans-serif;
  }
  :global(html[data-pre-theme='dark']) .cs-root {
    background-image:
      linear-gradient(rgba(236, 239, 251, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(236, 239, 251, 0.04) 1px, transparent 1px);
  }
  .cs-card {
    max-width: 560px;
    width: 100%;
    background: var(--cs-paper);
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
  }
  .cs-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(180deg, var(--cs-red), var(--cs-blue));
  }
  .cs-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--cs-fg-mute);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .cs-title {
    margin: 0 0 20px;
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .cs-title-jp {
    display: block;
  }
  .cs-title-en {
    display: block;
    margin-top: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 22px;
    color: var(--cs-fg-mute);
    letter-spacing: -0.005em;
  }
  .cs-body {
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.8;
  }
  .cs-redirect {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--cs-fg-mute);
  }
  .cs-redirect-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cs-red);
    box-shadow: 0 0 0 4px rgba(229, 55, 75, 0.15);
    animation: cs-pulse 1.4s ease-in-out infinite;
  }
  @keyframes cs-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .cs-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--cs-fg);
    color: var(--cs-bg);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.15s;
  }
  .cs-cta:hover {
    background: var(--cs-red);
    color: #fff;
  }

  @media (max-width: 600px) {
    .cs-card {
      padding: 36px 28px;
    }
    .cs-title {
      font-size: 28px;
    }
    .cs-title-en {
      font-size: 18px;
    }
  }
</style>
