---
import Base from '../layouts/Base.astro';
import { content } from '../data/content.ts';
import '../styles/data-flow.css';

const C = content;
---

<Base
  title="Personality — 大泉直人 / Naoto Oizumi"
  description="大泉直人の好きなもの、休日の過ごし方、研究の外側にある関心。"
>
  <main class="df-root personality-page" data-theme="light">
    <header class="personality-nav">
      <a class="personality-back" href="/">← TOP</a>
      <button
        type="button"
        class="df-theme-toggle"
        aria-label="テーマを切り替え"
      >
        <span class="ico" aria-hidden="true"></span>
        <span class="df-theme-toggle-label" aria-hidden="true">
          <span data-theme-option="light">LIGHT</span>
          <span class="df-theme-toggle-separator">/</span>
          <span data-theme-option="dark">DARK</span>
        </span>
      </button>
    </header>

    <section class="personality-hero">
      <div class="df-grid">
        <span class="df-eyebrow">
          <span class="dot" aria-hidden="true"></span>PERSONALITY / OFF THE FIELD
        </span>
        <h1 class="personality-title">
          研究の外側にある、<br />
          好きなもの。
        </h1>
        <p class="personality-lead">
          {C.personality.body}
          なんでも大好き。
        </p>
      </div>
    </section>

    <section class="personality-section">
      <div class="df-grid">
        <div class="personality-grid">
          {C.personality.bites.map((b, i) => (
            <article class="personality-card">
              <div class="personality-card-no">LIKE / {String(i + 1).padStart(2, '0')}</div>
              <div class="personality-card-emoji" aria-hidden="true">{b.emoji}</div>
              <p>{b.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer class="personality-footer">
      <a class="personality-footer-link" href="/">トップへ戻る</a>
      <a class="personality-footer-link" href="/cv">CVを見る</a>
    </footer>
  </main>
</Base>

<script>
  import '../scripts/theme.ts';
</script>

<style>
  .personality-page {
    min-height: 100vh;
  }

  .personality-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 72px;
    background: var(--df-paper);
    border-bottom: 1px solid var(--df-line);
  }

  .personality-back {
    font-family: var(--df-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--df-fg-mute);
  }

  .personality-back:hover {
    color: var(--df-blue);
  }

  .personality-hero {
    padding: 96px 0 64px;
  }

  .personality-title {
    margin: 28px 0 0;
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 900;
    font-size: 76px;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .personality-title::first-line {
    color: var(--df-red);
  }

  .personality-lead {
    max-width: 680px;
    margin: 28px 0 0;
    font-size: 18px;
    line-height: 1.9;
    color: var(--df-fg-mute);
    white-space: pre-line;
  }

  .personality-section {
    padding: 24px 0 96px;
  }

  .personality-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .personality-card {
    min-height: 210px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    background: var(--df-paper);
    border: 1px solid var(--df-line);
    border-radius: 6px;
  }

  .personality-card:nth-child(3n + 1) {
    border-top: 4px solid var(--df-red);
  }

  .personality-card:nth-child(3n + 2) {
    border-top: 4px solid var(--df-blue);
  }

  .personality-card:nth-child(3n) {
    border-top: 4px solid var(--df-fg);
  }

  .personality-card-no {
    font-family: var(--df-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--df-fg-mute);
  }

  .personality-card-emoji {
    font-size: 34px;
    line-height: 1;
  }

  .personality-card p {
    margin: auto 0 0;
    font-size: 15px;
    line-height: 1.75;
    white-space: pre-line;
  }

  .personality-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 72px;
    border-top: 1px solid var(--df-line);
    background: var(--df-paper);
  }

  .personality-footer-link {
    font-family: var(--df-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--df-fg-mute);
    text-transform: uppercase;
  }

  .personality-footer-link:hover {
    color: var(--df-blue);
  }

  @media (max-width: 900px) {
    .personality-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .personality-nav {
      padding: 14px 16px;
    }

    .personality-hero {
      padding: 56px 0 36px;
    }

    .personality-title {
      font-size: 42px;
      line-height: 1.15;
    }

    .personality-lead {
      font-size: 15px;
      line-height: 1.8;
    }

    .personality-section {
      padding: 12px 0 64px;
    }

    .personality-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .personality-card {
      min-height: 0;
      padding: 20px;
    }

    .personality-footer {
      flex-direction: column;
      padding: 24px 20px;
    }
  }
</style>
