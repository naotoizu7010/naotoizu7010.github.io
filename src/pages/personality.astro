---
import Base from '../layouts/Base.astro';
import { content } from '../data/content.ts';
import ThemeToggle from '../components/data-flow/ThemeToggle.astro';
import '../styles/data-flow.css';
import '../styles/personality.css';

const C = content;
---

<Base
  title="Personality — 大泉直人 / Naoto Oizumi"
  description="大泉直人の好きなもの、休日の過ごし方、研究の外側にある関心。"
>
  <main class="df-root personality-page" data-theme="light">
    <header class="personality-nav">
      <a class="personality-back" href="/">← TOP</a>
      <ThemeToggle />
    </header>

    <section class="personality-hero">
      <div class="df-grid">
        <span class="df-eyebrow">
          <span class="dot" aria-hidden="true"></span>PERSONALITY / OFF THE FIELD
        </span>
        <h1 class="personality-title">
          研究の外側にある、<br />
          好きなもの。
        </h1>
        <p class="personality-lead">
          {C.personality.body}
          なんでも大好き。
        </p>
      </div>
    </section>

    <section class="personality-section">
      <div class="df-grid">
        <div class="personality-grid">
          {C.personality.bites.map((b, i) => (
            <article class="personality-card">
              <div class="personality-card-no">LIKE / {String(i + 1).padStart(2, '0')}</div>
              <div class="personality-card-emoji" aria-hidden="true">{b.emoji}</div>
              <p>{b.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer class="personality-footer">
      <a class="personality-footer-link" href="/">トップへ戻る</a>
      <a class="personality-footer-link" href="/cv">CVを見る</a>
    </footer>
  </main>
</Base>

<script>
  import '../scripts/theme.ts';
</script>
