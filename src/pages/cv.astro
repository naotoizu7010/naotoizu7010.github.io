---
/* ----------------------------------------------------------------
   src/pages/cv.astro
   学歴・職歴をシンプルにまとめた文字ベースのページ。
   既存の docs/README.md の情報を構造化して使用。
   ---------------------------------------------------------------- */
import Base from '../layouts/Base.astro';
import { cv } from '../data/content.ts';
import '../styles/cv.css';
---

<Base title="CV — 大泉直人 / Naoto Oizumi" description="大泉直人の学歴・職歴。">
  <main class="cv-root">
    <header class="cv-header">
      <a href="/" class="cv-back">← Back to top</a>
      <h1 class="cv-name">大泉直人 <span lang="en">Naoto Oizumi</span></h1>
      <p class="cv-sub">last update: 2026/5/19</p>
    </header>

    <section class="cv-block">
      <h2 class="cv-h2">基本情報</h2>
      <dl class="cv-list">
        {cv.basic.map((b) => (
          <div class="cv-row">
            <dt>{b.k}</dt>
            <dd>
              {b.k === '所属' ? (
                <>
                  筑波大学 理工学群 社会工学類
                  <br class="cv-mobile-break" />
                  学部4年
                </>
              ) : (
                b.v
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">学歴</h2>
      <ul class="cv-events">
        {cv.education.map((e) => (
          <li>
            <time>{e.period}</time>
            <div>
              <h3>
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">{e.title}</a>
                ) : (
                  e.title
                )}
              </h3>
              {e.role && <p class="cv-role">{e.role}</p>}
              <p>
                {'noteParts' in e ? (
                  e.noteParts.map((part) => (
                    part.href ? (
                      <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
                    ) : (
                      part.text
                    )
                  ))
                ) : (
                  e.note
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv-block">
      <h2 class="cv-h2">職歴</h2>
      <ul class="cv-events">
        {cv.work.map((e) => (
          <li>
            <time>{e.period}</time>
            <div>
              <h3>
                {'titleParts' in e ? (
                  e.titleParts.map((part, index) => (
                    <>
                      {index > 0 && (
                        <>
                          <span class="cv-desktop-space"> </span>
                          <br class="cv-mobile-break" />
                        </>
                      )}
                      {part.href ? (
                        <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
                      ) : (
                        part.text
                      )}
                    </>
                  ))
                ) : e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">{e.title}</a>
                ) : (
                  e.title
                )}
              </h3>
              {e.role && <p class="cv-role">{e.role}</p>}
              <p>
                {'noteParts' in e ? (
                  e.noteParts.map((part) => (
                    part.href ? (
                      <a href={part.href} target="_blank" rel="noopener">{part.text}</a>
                    ) : (
                      part.text
                    )
                  ))
                ) : (
                  e.note
                )}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <footer class="cv-foot">
      <p>
        連絡先：
        <br class="cv-mobile-break" />
        各 SNS の DM、または naoto-oizumi[at]aist.go.jp
      </p>
      <p class="cv-foot-back">
        <a href="/">← Back to top</a>
      </p>
    </footer>
  </main>
</Base>
