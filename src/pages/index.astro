---
const title = 'Astro local setup';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">naotoizu7010.github.io</p>
      <h1>Astro local setup is ready.</h1>
      <p>
        This is a minimal Astro entry page for the local environment setup.
        The full portfolio migration will be handled in a later step.
      </p>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    min-height: 100vh;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: #151515;
    background: #f8f8f8;
  }

  main {
    width: min(100% - 32px, 720px);
    margin: 0 auto;
    padding: 96px 0;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #0057ff;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 8vw, 4.5rem);
    line-height: 1;
  }

  p {
    max-width: 56ch;
    font-size: 1.125rem;
    line-height: 1.7;
  }

  @media (prefers-color-scheme: dark) {
    :global(body) {
      color: #f7f7f7;
      background: #080808;
    }

    .eyebrow {
      color: #ff3030;
    }
  }
</style>
