---
/* ----------------------------------------------------------------
   src/components/DataFlowPage.astro
   トップページ本体。
   - 静的HTMLとしてレンダリング (Reactなし)
   - クライアント側の動き (テーマ・メニュー・背景アニメ) は scripts/ の TS で実装
   ---------------------------------------------------------------- */
import { content } from '../data/content.ts';
import ImageSlot from './ImageSlot.astro';
import '../styles/data-flow.css';

const C = content;
---

<div class="df-root" data-theme="light">
  <!-- NAV -->
  <nav class="df-nav" aria-label="Primary">
    <div class="df-nav-brand">
      <div class="df-nav-logo" aria-hidden="true"></div>
      <div class="df-nav-name">
        Naoto Oizumi
        <small>SPORTS × SOCIETY × DATA</small>
      </div>
    </div>
    <div class="df-nav-links">
      {C.nav.map((n) => (
        <a class="df-nav-link" href={n.href}>{n.label}</a>
      ))}
    </div>
    <div class="df-nav-right">
      <a class="df-researcher-link" href="/researcher">/researcher ↗</a>
      <button
        type="button"
        class="df-theme-toggle"
        aria-label="テーマを切り替え"
      >
        <span class="ico" aria-hidden="true"></span>
        <span class="df-theme-toggle-label">LIGHT</span>
      </button>
      <button
        type="button"
        class="df-burger"
        aria-label="メニューを開く"
        aria-expanded="false"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- モバイルメニュー -->
  <div class="df-menu" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="df-menu-head">
      <span class="df-menu-eyebrow">MENU</span>
      <button type="button" class="df-menu-close" aria-label="メニューを閉じる">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <ul class="df-menu-list">
      {C.nav.map((n, i) => (
        <li>
          <a class="df-menu-link" href={n.href}>
            <span class="df-menu-num">{String(i + 1).padStart(2, '0')}</span>
            <span>{n.label}</span>
            <span class="df-menu-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
      <li>
        <a class="df-menu-link df-menu-link--accent" href="/researcher">
          <span class="df-menu-num">↗</span>
          <span>/researcher (硬めの研究者ページ)</span>
          <span class="df-menu-arrow" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a class="df-menu-link" href="/cv">
          <span class="df-menu-num">↗</span>
          <span>/cv (学歴・職歴)</span>
          <span class="df-menu-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
    <div class="df-menu-foot">
      <button type="button" class="df-theme-toggle df-theme-toggle--big">
        <span class="ico" aria-hidden="true"></span>
        <span class="df-theme-toggle-label">LIGHT</span>
      </button>
    </div>
  </div>

  <!-- HERO -->
  <section class="df-hero" id="top">
    <div class="df-grid">
      <div class="df-hero-inner">
        <div>
          <div class="df-hero-eyebrow-row">
            <span class="df-hero-pill">
              <span class="dot" aria-hidden="true"></span>
              {C.hero.eyebrow}
            </span>
            <span
              style="font-family: var(--df-mono); font-size: 11px; letter-spacing: 0.16em; color: var(--df-fg-mute);"
            >
              TOP / 2026
            </span>
          </div>
          <h1 class="df-hero-title">
            <span>{C.hero.title_a}</span><br />
            <span class="red">読</span><span class="blue">む</span><span>。</span>
          </h1>
          <p class="df-hero-en">{C.hero.en_caption}</p>
          <p class="df-hero-sub">{C.hero.sub}</p>
          <div class="df-hero-meta">
            <span>ROLE / <b>Researcher</b></span>
            <span>BASE / <b>Tsukuba, JP</b></span>
            <span>FIELD / <b>Crowd · Sports · AI</b></span>
          </div>
        </div>
        <div class="df-hero-right">
          <span class="df-hero-coordinates">tsukuba / 茨城</span>
          <span class="df-hero-coordinates df-hero-coord-r">since 2003</span>
          <div class="df-hero-photo-wrap">
            <ImageSlot
              src="/img/main_profile.jpg"
              alt="大泉直人の写真"
              width={420}
              height={520}
              placeholder="本人写真 1:1.25"
            />
          </div>
          <div class="df-hero-stat-card df-hero-stat-card-1">
            <div class="k">所属</div>
            <div class="v blue">筑波大学</div>
          </div>
          <div class="df-hero-stat-card df-hero-stat-card-2">
            <div class="k">勤務</div>
            <div class="v red">産総研</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Researcher banner -->
  <a class="df-researcher-banner" href="/researcher">
    <div class="df-researcher-banner-inner">
      <span class="df-researcher-banner-tag">FOR RESEARCHERS</span>
      <span class="df-researcher-banner-title">
        業績・所属・論文は <b>/researcher</b> へ
      </span>
      <span class="df-researcher-banner-body">
        研究者向けの硬めのプロフィールページ。学会発表・査読論文・所属など、フォーマルな情報をまとめています。<br />
        ※準備中です。
      </span>
      <span class="df-researcher-banner-cta" aria-hidden="true">
        <span>OPEN</span>
        <span class="df-researcher-banner-arrow">→</span>
      </span>
    </div>
  </a>

  <!-- ABOUT -->
  <section class="df-section" id="about">
    <div class="df-grid">
      <div class="df-about-inner">
        <div class="df-about-head">
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>01 / ABOUT
          </span>
          <h2 class="df-h2-ja">
            つくばで<br />研究する大学生です。
          </h2>
          <div class="df-about-summary-card">
            <div class="k">いま、やっていること</div>
            <div class="body-text">スタジアムの人流とAIの社会実装をテーマに、研究と現場のあいだを行き来しています。</div>
          </div>
          <div class="df-about-summary-card df-about-summary-card-2">
            <div class="k">大事にしていること</div>
            <div class="body-text">"ややこしい話を、肩の力を抜いて。"<br />専門外の人とちゃんと話せる研究者でいたい。</div>
          </div>
        </div>
        <div>
          <p class="df-about-lead">{C.about.lead}</p>
          <p style="font-size: 16px; line-height: 1.8;">{C.about.body}</p>
          <p style="font-size: 16px; line-height: 1.8; margin-top: 16px;">{C.about.body2}</p>
          <div class="df-about-facts">
            {C.about.factoids.map((f) => (
              <div class="df-about-fact">
                <div class="k">{f.k}</div>
                <div class="v">{f.v}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEARCH -->
  <section class="df-section df-section--research" id="research">
    <div class="df-grid">
      <div class="df-research-head">
        <div>
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>02 / RESEARCH
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.research.heading}</h2>
        </div>
        <p style="max-width: 360px; color: var(--df-fg-mute); text-align: right; line-height: 1.7;">
          {C.research.intro}
        </p>
      </div>
      <div class="df-research-grid">
        {C.research.items.map((r) => (
          <article class="df-rcard">
            <div class="df-rcard-chart">
              {r.chart === 'crowd' && (
                <svg viewBox="0 0 360 160" width="100%" height="100%" aria-hidden="true">
                  {Array.from({ length: 8 }).flatMap((_, y) =>
                    Array.from({ length: 18 }).map((__, x) => {
                      const d = Math.sqrt((x - 11) ** 2 + (y - 4) ** 2);
                      const v = Math.max(0, 1 - d / 8);
                      return (
                        <rect
                          x={x * 20 + 1}
                          y={y * 20 + 1}
                          width="18"
                          height="18"
                          fill="var(--df-red)"
                          opacity={v * 0.85}
                        />
                      );
                    }),
                  )}
                  <path
                    d="M 20 130 Q 100 90 200 80 T 340 40"
                    fill="none"
                    stroke="var(--df-fg)"
                    stroke-width="1.5"
                    stroke-dasharray="3 4"
                  />
                </svg>
              )}
              {r.chart === 'sports' && (
                <svg viewBox="0 0 360 160" width="100%" height="100%" aria-hidden="true">
                  {[0, 1, 2, 3].map((i) => (
                    <line
                      x1="0"
                      x2="360"
                      y1={40 * (i + 1) - 20}
                      y2={40 * (i + 1) - 20}
                      stroke="var(--df-line)"
                      stroke-width="0.5"
                    />
                  ))}
                  {[0, 1, 2, 3, 4].map((i) => (
                    <line
                      x1={72 * i}
                      x2={72 * i}
                      y1="0"
                      y2="160"
                      stroke="var(--df-line)"
                      stroke-width="0.5"
                    />
                  ))}
                  <path
                    d="M 40 130 Q 120 60 200 90 T 330 30"
                    fill="none"
                    stroke="var(--df-fg)"
                    stroke-width="1.5"
                  />
                  <circle cx="40" cy="130" r="5" fill="var(--df-fg)" />
                  <circle cx="120" cy="80" r="5" fill="var(--df-blue)" opacity="0.6" />
                  <circle cx="200" cy="90" r="6" fill="var(--df-blue)" />
                  <circle cx="260" cy="60" r="4" fill="var(--df-red)" opacity="0.6" />
                  <circle cx="330" cy="30" r="6" fill="var(--df-red)" />
                </svg>
              )}
              {r.chart === 'city' && (
                <svg viewBox="0 0 360 160" width="100%" height="100%" aria-hidden="true">
                  <line x1="60" y1="20" x2="180" y2="20" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <line x1="180" y1="20" x2="260" y2="80" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <line x1="180" y1="20" x2="80" y2="120" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <line x1="260" y1="80" x2="320" y2="120" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <line x1="80" y1="120" x2="160" y2="140" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <line x1="160" y1="140" x2="260" y2="80" stroke="var(--df-fg-mute)" stroke-width="1" opacity="0.5" />
                  <circle cx="60" cy="20" r="8" fill="var(--df-red)" />
                  <circle cx="180" cy="20" r="14" fill="var(--df-blue)" />
                  <circle cx="260" cy="80" r="10" fill="var(--df-fg)" />
                  <circle cx="320" cy="120" r="7" fill="var(--df-blue)" />
                  <circle cx="80" cy="120" r="9" fill="var(--df-red)" />
                  <circle cx="160" cy="140" r="6" fill="var(--df-fg)" />
                </svg>
              )}
            </div>
            <div class="df-rcard-head">
              <span class="df-rcard-no">RES / {r.no}</span>
              <span class="df-rcard-tag">{r.tag}</span>
            </div>
            <div class="df-rcard-en">{r.en}</div>
            <h3 class="df-rcard-ja">{r.ja}</h3>
            <p class="df-rcard-body">{r.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ACTIVITIES -->
  <section class="df-section" id="activities">
    <div class="df-grid">
      <div class="df-act-head">
        <div>
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>03 / ACTIVITIES
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.activities.heading}</h2>
        </div>
        <p style="max-width: 360px; color: var(--df-fg-mute); text-align: right; line-height: 1.7;">
          {C.activities.lead}
        </p>
      </div>
      <div class="df-act-list">
        {C.activities.items.map((a, i) => (
          <a
            class="df-act-row"
            href={a.href ?? '#'}
            target={a.href ? '_blank' : undefined}
            rel={a.href ? 'noopener' : undefined}
          >
            <div class="df-act-node">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="df-act-cat">{a.tag}</div>
              <div class="df-act-title">{a.title}</div>
            </div>
            <div class="df-act-body">{a.body}</div>
            <div class="df-act-meta">
              {a.meta.since && <span>since <b>{a.meta.since}</b></span>}
              {a.meta.role && <span>role <b>{a.meta.role}</b></span>}
              {a.meta.cases && <span>cases <b>{a.meta.cases}</b></span>}
            </div>
            <div class="df-act-cta">{a.href ? 'OPEN' : 'DETAIL'}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PERSONALITY -->
  <section class="df-section df-section--personality" id="personality">
    <div class="df-grid">
      <div class="df-pers-inner">
        <div class="df-pers-head">
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>04 / OFF THE FIELD
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.personality.heading}</h2>
          <p style="color: var(--df-fg-mute); line-height: 1.8; margin-top: 16px;">
            {C.personality.lead}<br /><br />
            {C.personality.body}
          </p>
          <div
            style="margin-top: 32px; font-family: var(--df-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--df-fg-mute); text-transform: uppercase;"
          >
            <span
              style="display: inline-block; width: 24px; height: 1px; background: var(--df-blue); margin-right: 12px; vertical-align: middle;"
            ></span>
            NODES = INTERESTS · EDGES = HOW THEY CONNECT
          </div>
        </div>
        <div class="df-pers-network">
          <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;"
            aria-hidden="true"
          >
            {[[14, 22, 58, 14], [58, 14, 84, 40], [14, 22, 24, 62], [58, 14, 52, 78], [24, 62, 52, 78], [52, 78, 78, 86], [84, 40, 78, 86], [84, 40, 52, 78]].map(([x1, y1, x2, y2]) => (
              <line
                x1={x1}
                y1={y1}
                x2={x2}
                y2={y2}
                stroke="var(--df-fg-mute)"
                stroke-width="0.2"
                stroke-dasharray="0.8 0.8"
                opacity="0.6"
              />
            ))}
            {[[14, 22], [58, 14], [84, 40], [24, 62], [52, 78], [78, 86]].map(([cx, cy]) => (
              <circle cx={cx} cy={cy} r="0.7" fill="var(--df-blue)" />
            ))}
          </svg>
          {C.personality.bites.map((b, i) => {
            const positions = [
              { left: '8%', top: '8%' },
              { left: '52%', top: '4%' },
              { left: '78%', top: '24%' },
              { left: '14%', top: '30%' },
              { left: '46%', top: '40%' },
              { left: '72%', top: '52%' },
              { left: '18%', top: '60%' },
              { left: '54%', top: '72%' },
              { left: '78%', top: '82%' },
            ];
            const pos = positions[i] || positions[i % positions.length];
            return (
              <span class="df-bite-tag" style={`left: ${pos.left}; top: ${pos.top};`}>
                <span class="emo">{b.emoji}</span>
                <span>{b.text}</span>
              </span>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- LINKS -->
  <section class="df-section" id="links">
    <div class="df-grid">
      <div class="df-links-head">
        <div>
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>05 / LINKS
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.links.heading}</h2>
        </div>
        <p style="max-width: 320px; color: var(--df-fg-mute); text-align: right; line-height: 1.7;">
          {C.links.lead}
        </p>
      </div>
      <div class="df-links-grid">
        {C.links.items.map((l, i) => (
          <a
            class="df-link-card"
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener' : undefined}
          >
            <div class="df-link-card-no">N° {String(i + 1).padStart(2, '0')}</div>
            <h3 class="df-link-card-title">{l.title}</h3>
            <p class="df-link-card-body">{l.body}</p>
            <span class="df-link-card-cta">{l.cta}</span>
            <span class="df-link-card-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="df-footer">
    <div class="df-footer-inner">
      <div class="df-footer-top">
        <div>
          <div class="df-footer-big">
            {C.footer.big_top}<br />
            <span class="red">{C.footer.big_red}</span><br />
            <span class="blue">{C.footer.big_blue}</span>
          </div>
          <a class="df-footer-cta" href={C.footer.cta_href} target="_blank" rel="noopener">
            {C.footer.cta_label}
          </a>
        </div>
        <div class="df-footer-sns">
          <h4>FIND ME</h4>
          <ul>
            {C.footer.sns.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="df-footer-bottom">
        <span>{C.footer.legal}</span>
        <a href="#top" style="opacity: 0.7;">↑ TOP</a>
      </div>
    </div>
  </footer>
</div>

<!-- Client scripts (Astro が自動でバンドル) -->
<script>
  import '../scripts/theme.ts';
  import '../scripts/menu.ts';
  import '../scripts/data-flow-bg.ts';
</script>
