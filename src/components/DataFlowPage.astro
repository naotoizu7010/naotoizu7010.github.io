---
/* ----------------------------------------------------------------
   src/components/DataFlowPage.astro
   トップページ本体。
   - 静的HTMLとしてレンダリング (Reactなし)
   - クライアント側の動き (テーマ・メニュー・背景アニメ) は scripts/ の TS で実装
   ---------------------------------------------------------------- */
import { content } from '../data/content.ts';
import ImageSlot from './ImageSlot.astro';
import '../styles/data-flow.css';

const C = content;
---

<div class="df-root" data-theme="light">
  <!-- NAV -->
  <nav class="df-nav" aria-label="Primary">
    <div class="df-nav-brand">
      <div class="df-nav-name">
        Naoto Oizumi
        <small>SPORTS × SOCIETY × DATA</small>
      </div>
    </div>
    <div class="df-nav-links">
      {C.nav.map((n) => (
        <a class="df-nav-link" href={n.href}>{n.label}</a>
      ))}
    </div>
    <div class="df-nav-right">
      <a class="df-lang-link" href="/en" aria-label="English page">
        <span class="df-lang-ico" aria-hidden="true"></span>
        <span>EN</span>
      </a>
      <button
        type="button"
        class="df-theme-toggle"
        aria-label="テーマを切り替え"
      >
        <span class="ico" aria-hidden="true"></span>
        <span class="df-theme-toggle-label" aria-hidden="true">
          <span data-theme-option="light">LIGHT</span>
          <span class="df-theme-toggle-separator">/</span>
          <span data-theme-option="dark">DARK</span>
        </span>
      </button>
      <button
        type="button"
        class="df-burger"
        aria-label="メニューを開く"
        aria-expanded="false"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </nav>

  <!-- モバイルメニュー -->
  <div class="df-menu" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="df-menu-head">
      <span class="df-menu-eyebrow">MENU</span>
      <button type="button" class="df-menu-close" aria-label="メニューを閉じる">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
    <ul class="df-menu-list">
      {C.nav.map((n, i) => (
        <li>
          <a class="df-menu-link" href={n.href}>
            <span class="df-menu-num">{String(i + 1).padStart(2, '0')}</span>
            <span>{n.label}</span>
            <span class="df-menu-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- HERO -->
  <section class="df-hero" id="top">
    <div class="df-grid">
      <div class="df-hero-inner">
        <div>
          <h1 class="df-hero-title">
            <span class="red">人の</span><span class="blue">流れ</span><span>を、</span><br />
            <span>読む。</span>
          </h1>
          <p class="df-hero-en">{C.hero.en_caption}</p>
          <p class="df-hero-sub">{C.hero.sub}</p>
          <div class="df-hero-meta">
            <span>ROLE / <b>Undergrad Student</b></span>
            <span>BASE / <b>Tsukuba, JP</b></span>
            <span>FIELD / <b>Crowd Analysis · AI</b></span>
          </div>
        </div>
        <div class="df-hero-right">
          <div class="df-hero-photo-wrap">
            <ImageSlot
              srcs={[
                '/img/main_profile.jpg',
                '/img/naoto_oizumi_medium_body_white_1-1.png',
                '/img/profile_pixel.jpg',
              ]}
              alt="大泉直人の写真"
              width={420}
              height={520}
              interval={4800}
              fade={1100}
              placeholder="本人写真 1:1.25"
            />
          </div>
          <div class="df-hero-stat-card df-hero-stat-card-1">
            <div class="k">所属</div>
            <div class="v blue">筑波大学</div>
          </div>
          <div class="df-hero-stat-card df-hero-stat-card-2">
            <div class="k">勤務</div>
            <div class="v red">産業技術総合研究所</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="df-section" id="about">
    <div class="df-grid">
      <div class="df-about-inner">
        <div class="df-about-head">
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>01 / ABOUT
          </span>
          <h2 class="df-h2-ja">
            {C.about.heading_ja[0]}<br />{C.about.heading_ja[1]}
          </h2>
          <div class="df-about-summary-card">
            <div class="k">いま、やっていること</div>
            <div class="body-text">スタジアムでの人流の解析と、AIを用いた社会実装に取り組んでいます。</div>
          </div>
          <div class="df-about-summary-card df-about-summary-card-2">
            <div class="k">大事にしていること</div>
            <div class="body-text">何事にも興味を持つこと。好奇心を満たし続けること。</div>
          </div>
        </div>
        <div>
          <p class="df-about-lead">{C.about.lead}</p>
          <p class="df-about-copy">{C.about.body}</p>
          <p class="df-about-copy df-about-copy--spaced">{C.about.body2}</p>
          <div class="df-about-facts">
            {C.about.factoids.map((f) => (
              <div class="df-about-fact">
                <div class="k">{f.k}</div>
                <div class="v">
                  {f.vParts ? (
                    f.vParts.map((part) => (
                      part.href ? (
                        <a
                          href={part.href}
                          target="_blank"
                          rel="noopener"
                          class:list={[part.tone === 'muted' && 'df-about-fact-muted']}
                        >
                          {part.text}
                        </a>
                      ) : (
                        <span
                          class:list={[
                            part.tone === 'muted' && 'df-about-fact-muted',
                            part.tone === 'gap' && 'df-about-fact-gap',
                          ]}
                        >
                          {part.text}
                        </span>
                      )
                    ))
                  ) : (
                    f.v
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ACTIVITIES -->
  <section class="df-section" id="activities">
    <div class="df-grid">
      <div class="df-act-head">
        <div>
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>02 / ACTIVITIES
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.activities.heading}</h2>
        </div>
        <p style="max-width: 360px; color: var(--df-fg-mute); text-align: right; line-height: 1.7;">
          {C.activities.lead}
        </p>
      </div>
      <div class="df-act-list">
        {C.activities.items.map((a, i) => (
          <a
            class="df-act-row"
            href={a.href ?? '#'}
            target={a.href ? '_blank' : undefined}
            rel={a.href ? 'noopener' : undefined}
          >
            <div class="df-act-node">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <div class="df-act-cat">{a.tag}</div>
              <div class="df-act-title">
                {a.title}
              </div>
              {a.titleSub && <div class="df-act-title-sub">{a.titleSub}</div>}
            </div>
            <div class="df-act-body">{a.body}</div>
            <div class="df-act-meta">
              {a.meta.since && <span>since <b>{a.meta.since}</b></span>}
              {a.meta.role && <span>role <b>{a.meta.role}</b></span>}
              {a.meta.cases && <span>cases <b>{a.meta.cases}</b></span>}
            </div>
            <div class="df-act-cta">{a.cta ?? (a.href ? 'OPEN' : 'DETAIL')}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PERSONALITY -->
  <section class="df-section df-section--personality" id="personality">
    <div class="df-grid">
      <div class="df-pers-inner">
        <div class="df-pers-head">
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>03 / personality
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.personality.heading}</h2>
          <p class="df-pers-copy">
            {C.personality.lead}<br /><br />
            {C.personality.body}
          </p>
          <div
            style="margin-top: 32px; font-family: var(--df-mono); font-size: 11px; letter-spacing: 0.14em; color: var(--df-fg-mute); text-transform: uppercase;"
          >
            <span
              style="display: inline-block; width: 24px; height: 1px; background: var(--df-blue); margin-right: 12px; vertical-align: middle;"
            ></span>

          </div>
          <a class="df-pers-detail-link" href="/personality">
            <span>もっと人柄を知る（準備中）</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="df-pers-network">
          <svg
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;"
            aria-hidden="true"
          >
            {[[14, 22, 58, 14], [58, 14, 84, 40], [14, 22, 24, 62], [58, 14, 52, 78], [24, 62, 52, 78], [52, 78, 78, 86], [84, 40, 78, 86], [84, 40, 52, 78]].map(([x1, y1, x2, y2]) => (
              <line
                x1={x1}
                y1={y1}
                x2={x2}
                y2={y2}
                stroke="var(--df-fg-mute)"
                stroke-width="0.2"
                stroke-dasharray="0.8 0.8"
                opacity="0.6"
              />
            ))}
            {[[14, 22], [58, 14], [84, 40], [24, 62], [52, 78], [78, 86]].map(([cx, cy]) => (
              <circle cx={cx} cy={cy} r="0.7" fill="var(--df-blue)" />
            ))}
          </svg>
          {C.personality.bites.map((b, i) => {
            const positions = [
              { left: '8%', top: '8%' },
              { left: '52%', top: '4%' },
              { left: '78%', top: '24%' },
              { left: '14%', top: '30%' },
              { left: '46%', top: '40%' },
              { left: '72%', top: '52%' },
              { left: '18%', top: '60%' },
              { left: '54%', top: '72%' },
              { left: '78%', top: '82%' },
            ];
            const pos = positions[i] || positions[i % positions.length];
            return (
              <span class="df-bite-tag" style={`left: ${pos.left}; top: ${pos.top};`}>
                <span class="emo">{b.emoji}</span>
                <span>{b.text}</span>
              </span>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- LINKS -->
  <section class="df-section" id="links">
    <div class="df-grid">
      <div class="df-links-head">
        <div>
          <span class="df-eyebrow">
            <span class="dot" aria-hidden="true"></span>04 / LINKS
          </span>
          <h2 class="df-h2-ja" style="margin-top: 16px;">{C.links.heading}</h2>
        </div>
        <p style="max-width: 320px; color: var(--df-fg-mute); text-align: right; line-height: 1.7;">
          {C.links.lead}
        </p>
      </div>
      <div class="df-links-grid">
        {C.links.items.map((l, i) => (
          <a
            class="df-link-card"
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener' : undefined}
          >
            <div class="df-link-card-no"> {String(i + 1).padStart(2, '0')}</div>
            <h3 class="df-link-card-title">{l.title}</h3>
            <p class="df-link-card-body">{l.body}</p>
            <span class="df-link-card-cta">{l.cta}</span>
            <span class="df-link-card-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="df-footer">
    <div class="df-footer-inner">
      <div class="df-footer-top">
        <div>
          <div class="df-footer-big">
            {C.footer.big_top}<br />
            <span class="red">{C.footer.big_red}</span><br />
            <span class="blue">{C.footer.big_blue}</span>
          </div>
          <a
            class="df-footer-cta"
            href={C.footer.cta_href}
            target={C.footer.cta_href.startsWith('http') ? '_blank' : undefined}
            rel={C.footer.cta_href.startsWith('http') ? 'noopener' : undefined}
          >
            {C.footer.cta_label}
          </a>
        </div>
        <div class="df-footer-sns">
          <h4>FIND ME</h4>
          <ul>
            {C.footer.sns.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">{s.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="df-footer-bottom">
        <span>{C.footer.legal}</span>
        <a href="#top" style="opacity: 0.7;">↑ TOP</a>
      </div>
    </div>
  </footer>
</div>

<!-- Client scripts (Astro が自動でバンドル) -->
<script>
  import '../scripts/theme.ts';
  import '../scripts/menu.ts';
  import '../scripts/data-flow-bg.ts';
</script>
