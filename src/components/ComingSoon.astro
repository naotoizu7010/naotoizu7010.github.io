---
import '../styles/coming-soon.css';

interface Props {
  titleJa?: string;
  titleEn?: string;
  body: string;
  redirectSeconds?: number;
  redirectHref?: string;
  ctaLabel?: string;
}

const {
  titleJa = '準備中です。',
  titleEn = 'Coming soon.',
  body,
  redirectSeconds = 5,
  redirectHref = '/',
  ctaLabel = 'いますぐトップへ →',
} = Astro.props;
---

<main
  class="cs-root"
  data-redirect-seconds={redirectSeconds}
  data-redirect-href={redirectHref}
>
  <div class="cs-card">
    <h1 class="cs-title">
      <span class="cs-title-jp">{titleJa}</span>
      <span class="cs-title-en">{titleEn}</span>
    </h1>
    <p class="cs-body">{body}</p>
    <p class="cs-redirect">
      <span class="cs-redirect-dot"></span>
      <span id="redirect-count">{redirectSeconds}</span> 秒後にトップへ移動します
    </p>
    <a href={redirectHref} class="cs-cta">{ctaLabel}</a>
  </div>
</main>

<script>
  const root = document.querySelector<HTMLElement>('.cs-root');
  const countEl = document.getElementById('redirect-count');
  const initialCount = Number(root?.dataset.redirectSeconds ?? '5');
  const redirectHref = root?.dataset.redirectHref ?? '/';
  let count = Number.isFinite(initialCount) ? initialCount : 5;

  const timer = window.setInterval(() => {
    count -= 1;
    if (countEl) {
      countEl.textContent = String(Math.max(count, 0));
    }
    if (count <= 0) {
      window.clearInterval(timer);
      window.location.replace(redirectHref);
    }
  }, 1000);
</script>
