---
interface Props {
  titleJa?: string;
  titleEn?: string;
  body: string;
  redirectSeconds?: number;
  redirectHref?: string;
  ctaLabel?: string;
}

const {
  titleJa = '準備中です。',
  titleEn = 'Coming soon.',
  body,
  redirectSeconds = 5,
  redirectHref = '/',
  ctaLabel = 'いますぐトップへ →',
} = Astro.props;
---

<main
  class="cs-root"
  data-redirect-seconds={redirectSeconds}
  data-redirect-href={redirectHref}
>
  <div class="cs-card">
    <h1 class="cs-title">
      <span class="cs-title-jp">{titleJa}</span>
      <span class="cs-title-en">{titleEn}</span>
    </h1>
    <p class="cs-body">{body}</p>
    <p class="cs-redirect">
      <span class="cs-redirect-dot"></span>
      <span id="redirect-count">{redirectSeconds}</span> 秒後にトップへ移動します
    </p>
    <a href={redirectHref} class="cs-cta">{ctaLabel}</a>
  </div>
</main>

<script>
  const root = document.querySelector<HTMLElement>('.cs-root');
  const countEl = document.getElementById('redirect-count');
  const initialCount = Number(root?.dataset.redirectSeconds ?? '5');
  const redirectHref = root?.dataset.redirectHref ?? '/';
  let count = Number.isFinite(initialCount) ? initialCount : 5;

  const timer = window.setInterval(() => {
    count -= 1;
    if (countEl) {
      countEl.textContent = String(Math.max(count, 0));
    }
    if (count <= 0) {
      window.clearInterval(timer);
      window.location.replace(redirectHref);
    }
  }, 1000);
</script>

<style>
  :root {
    --cs-fg: #0a0f1f;
    --cs-fg-mute: #6a7286;
    --cs-line: #dde2ec;
    --cs-bg: #f7f8fb;
    --cs-paper: #ffffff;
    --cs-red: #e5374b;
    --cs-blue: #2a56f0;
  }
  :global(html[data-pre-theme='dark']) {
    --cs-fg: #eceffb;
    --cs-fg-mute: #7782a0;
    --cs-line: #1a1f35;
    --cs-bg: #060814;
    --cs-paper: #0b0f22;
    --cs-red: #ff4e62;
    --cs-blue: #5a7cff;
  }

  .cs-root {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background: var(--cs-bg);
    color: var(--cs-fg);
    background-image:
      linear-gradient(rgba(10, 15, 31, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(10, 15, 31, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    font-family: 'Inter', 'Noto Sans JP', system-ui, sans-serif;
  }
  :global(html[data-pre-theme='dark']) .cs-root {
    background-image:
      linear-gradient(rgba(236, 239, 251, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(236, 239, 251, 0.04) 1px, transparent 1px);
  }
  .cs-card {
    max-width: 560px;
    width: 100%;
    background: var(--cs-paper);
    border: 1px solid var(--cs-line);
    border-radius: 6px;
    padding: 48px 40px;
    position: relative;
    overflow: hidden;
  }
  .cs-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: linear-gradient(180deg, var(--cs-red), var(--cs-blue));
  }
  .cs-title {
    margin: 0 0 20px;
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 800;
    font-size: 36px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .cs-title-jp {
    display: block;
  }
  .cs-title-en {
    display: block;
    margin-top: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 500;
    font-size: 22px;
    color: var(--cs-fg-mute);
    letter-spacing: -0.005em;
  }
  .cs-body {
    margin: 0 0 32px;
    font-size: 15px;
    line-height: 1.8;
    white-space: pre-line;
  }
  .cs-redirect {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--cs-fg-mute);
  }
  .cs-redirect-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cs-red);
    box-shadow: 0 0 0 4px rgba(229, 55, 75, 0.15);
    animation: cs-pulse 1.4s ease-in-out infinite;
  }
  @keyframes cs-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  .cs-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--cs-fg);
    color: var(--cs-bg);
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.15s;
  }
  .cs-cta:hover {
    background: var(--cs-red);
    color: #fff;
  }

  @media (max-width: 600px) {
    .cs-card {
      padding: 36px 28px;
    }
    .cs-title {
      font-size: 28px;
    }
    .cs-title-en {
      font-size: 18px;
    }
  }
</style>
