---
/* ----------------------------------------------------------------
   src/components/ImageSlot.astro
   写真表示の薄いラッパー。
   - src がある: <img> を表示 (alt 必須)
   - srcs (配列) がある: 複数枚を自動 crossfade で切り替え
   - src がない: 「ここに画像をどうぞ」プレースホルダ
   width / height は CSS の aspect-ratio に使うので、論理サイズを渡してOK
   ---------------------------------------------------------------- */

interface Props {
  src?: string;
  /** 複数渡すと自動切り替え。1枚なら src と同等 */
  srcs?: string[];
  alt: string;
  width: number;
  height: number;
  placeholder?: string;
  rounded?: boolean;
  /** rect / circle / pill — clip shape */
  shape?: 'rect' | 'circle' | 'pill';
  /** 1枚あたりの表示時間 (ms) */
  interval?: number;
  /** crossfade 時間 (ms) */
  fade?: number;
  class?: string;
}

const {
  src,
  srcs,
  alt,
  width,
  height,
  placeholder = '画像をここに',
  rounded = false,
  shape = 'rect',
  interval = 4500,
  fade = 1100,
  class: className = '',
} = Astro.props;

const aspect = `${width} / ${height}`;
const classes = ['pf-img', `pf-img--${shape}`, rounded ? 'pf-img--rounded' : '', className]
  .filter(Boolean)
  .join(' ');
const list = srcs && srcs.length > 0 ? srcs : src ? [src] : [];
const isSlideshow = list.length > 1;
---

{
  isSlideshow ? (
    <div
      class={`${classes} pf-img--slideshow`}
      style={`aspect-ratio: ${aspect};`}
      role="img"
      aria-label={alt}
      data-interval={interval}
      data-fade={fade}
    >
      {list.map((s, i) => (
        <img
          src={s}
          alt={i === 0 ? alt : ''}
          width={width}
          height={height}
          class={`pf-img-slide ${i === 0 ? 'is-active' : ''}`}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          aria-hidden={i === 0 ? 'false' : 'true'}
        />
      ))}
    </div>
  ) : list.length === 1 ? (
    <img
      src={list[0]}
      alt={alt}
      width={width}
      height={height}
      class={classes}
      style={`aspect-ratio: ${aspect};`}
      loading="lazy"
      decoding="async"
    />
  ) : (
    <div class={`${classes} pf-img--placeholder`} role="img" aria-label={alt} style={`aspect-ratio: ${aspect};`}>
      <span class="pf-img-placeholder-text">{placeholder}</span>
    </div>
  )
}

<style>
  .pf-img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .pf-img--rect {
    border-radius: 6px;
  }
  .pf-img--rounded {
    border-radius: 12px;
  }
  .pf-img--circle {
    border-radius: 50%;
    aspect-ratio: 1 / 1;
  }
  .pf-img--pill {
    border-radius: 999px;
  }
  .pf-img--placeholder {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(
      45deg,
      rgba(10, 15, 31, 0.04),
      rgba(10, 15, 31, 0.04) 8px,
      rgba(10, 15, 31, 0.07) 8px,
      rgba(10, 15, 31, 0.07) 16px
    );
    color: var(--df-fg-mute, #6a7286);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border: 1px dashed currentColor;
  }
  .pf-img-placeholder-text {
    opacity: 0.8;
    text-align: center;
    padding: 10px 14px;
    line-height: 1.5;
  }

  .pf-img--slideshow {
    position: relative;
    width: 100%;
    height: auto;
    overflow: hidden;
    isolation: isolate;
  }
  .pf-img-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: translateX(var(--pf-enter-x, 18px)) scale(1.015);
    transition: opacity 1100ms ease, transform 6000ms ease-out;
    will-change: opacity, transform;
    border-radius: inherit;
  }
  .pf-img-slide.is-active {
    opacity: 1;
    transform: translateX(0) scale(1.045);
  }
  .pf-img-slide.is-leaving {
    opacity: 0;
    transform: translateX(var(--pf-exit-x, -18px)) scale(1.025);
  }

  @media (prefers-reduced-motion: reduce) {
    .pf-img-slide {
      transition: opacity 400ms ease;
      transform: none !important;
    }
  }
</style>

<script>
  function initImageSlideshow(root: HTMLElement) {
    if (root.dataset.slideshowReady === '1') return;
    root.dataset.slideshowReady = '1';

    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.pf-img-slide'));
    if (slides.length < 2) return;

    const interval = Number(root.dataset.interval || 4500);
    const fade = Number(root.dataset.fade || 1100);
    slides.forEach((slide) => {
      slide.style.transitionDuration = `${fade}ms, ${Math.max(interval + fade, 4000)}ms`;
    });

    let index = 0;
    let timer: number | undefined;
    const tick = () => {
      const current = index;
      const next = (current + 1) % slides.length;
      const direction = next > current || (current === slides.length - 1 && next === 0) ? 1 : -1;
      slides[current].style.setProperty('--pf-exit-x', `${direction * -18}px`);
      slides[next].style.setProperty('--pf-enter-x', `${direction * 18}px`);

      slides[current].classList.remove('is-active');
      slides[current].classList.add('is-leaving');
      slides[current].setAttribute('aria-hidden', 'true');
      slides[next].classList.add('is-active');
      slides[next].setAttribute('aria-hidden', 'false');
      window.setTimeout(() => {
        slides[current].classList.remove('is-leaving');
      }, fade);
      index = next;
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      timer = window.setInterval(tick, interval);
    };

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else start();
    });
    start();
  }

  function initAllImageSlideshows() {
    document.querySelectorAll<HTMLElement>('.pf-img--slideshow').forEach(initImageSlideshow);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllImageSlideshows, { once: true });
  } else {
    initAllImageSlideshows();
  }
</script>
