---
/* ----------------------------------------------------------------
   src/components/home/About.astro
   左に紹介文とCTA、右に4つのハイライト。
   ---------------------------------------------------------------- */
import { content } from '../../data/content.ts';

const C = content;
const factOf = (k: string) => C.about.factoids.find((f) => f.k === k)?.v ?? '';

const highlights = [
  { k: '大事にしていること', v: '何事にも興味を持つこと。好奇心を満たし続けること。' },
  { k: '専門', v: factOf('専門') },
  { k: '居住地', v: factOf('居住地') },
  { k: '出身地', v: factOf('出身地') },
];
---

<section class="hp-section hp-section--bg hp-section--wm" id="about">
  <div class="hp-cut hp-cut--top hp-cut--paper" aria-hidden="true"></div>
  <div class="hp-watermark hp-watermark--left" aria-hidden="true">About</div>

  <div class="hp-container">
    <div class="hp-about-inner">
      <div class="hp-reveal">
        <span class="hp-eyebrow"><span>01 / About</span></span>
        <h2 class="hp-h2">
          {C.about.heading_ja[0]}<br />{C.about.heading_ja[1]}
        </h2>
        <p class="hp-lead">{C.about.lead}</p>
        <p class="hp-lead">{C.about.body}</p>
        <div class="hp-about-actions">
          <a class="hp-btn hp-btn--primary" href="/cv">
            CVを見る<span class="hp-arrow" aria-hidden="true">→</span>
          </a>
          <a class="hp-btn hp-btn--outline" href="#profile">基本情報</a>
        </div>
      </div>

      <div class="hp-highlights hp-reveal">
        {highlights.map((h) => (
          <div class="hp-highlight">
            <div class="k">{h.k}</div>
            <div class="v">{h.v}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
