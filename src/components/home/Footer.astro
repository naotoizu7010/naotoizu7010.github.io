---
/* ----------------------------------------------------------------
   src/components/home/Footer.astro
   濃色のマルチカラムフッター。
   ---------------------------------------------------------------- */
import { content } from '../../data/content.ts';

const C = content;
---

<footer class="hp-footer">
  <div class="hp-watermark hp-watermark--right" aria-hidden="true">Oizumi</div>

  <div class="hp-container">
    <div class="hp-footer-top">
      <div class="hp-footer-brand">
        <div class="hp-footer-name">{C.name_en}</div>
        <div class="hp-footer-tagline">Sports × Society × Data</div>
        <p class="hp-footer-desc">{C.hero.sub}</p>
      </div>

      <div>
        <h4>Pages</h4>
        <ul class="hp-footer-list">
          {C.nav.map((n) => (
            <li><a href={n.href}>{n.label}</a></li>
          ))}
          <li><a href="/cv">CV</a></li>
          <li><a href="/en">English</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Find me</h4>
        <ul class="hp-footer-list hp-footer-list--sns">
          {C.footer.sns.map((s) => (
            <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hp-footer-bottom">
      <span>{C.footer.legal}</span>
      <a href="#top">↑ TOP</a>
    </div>
  </div>
</footer>
