---
/* ----------------------------------------------------------------
   src/components/home/Profile.astro
   会社概要テーブル相当。基本情報を定義リストで並べる。
   ---------------------------------------------------------------- */
import { content } from '../../data/content.ts';

const C = content;
---

<section class="hp-section hp-section--bg" id="profile">
  <div class="hp-cut hp-cut--top hp-cut--paper" aria-hidden="true"></div>

  <div class="hp-container">
    <div class="hp-profile-inner">
      <div class="hp-reveal">
        <span class="hp-eyebrow hp-eyebrow--red"><span>Profile</span></span>
        <h2 class="hp-h2">基本情報</h2>
        <p class="hp-lead">所属や専門をまとめています。</p>
      </div>

      <dl class="hp-table hp-reveal">
        {C.about.factoids.map((f) => (
          <div class="hp-row">
            <dt>{f.k}</dt>
            <dd>
              {f.vParts
                ? f.vParts.map((part) =>
                    part.href ? (
                      <a
                        href={part.href}
                        target="_blank"
                        rel="noopener"
                        class:list={[part.tone === 'muted' && 'hp-muted']}
                      >
                        {part.text}
                      </a>
                    ) : (
                      <span
                        class:list={[
                          part.tone === 'muted' && 'hp-muted',
                          part.tone === 'gap' && 'hp-gap',
                        ]}
                      >
                        {part.text}
                      </span>
                    ),
                  )
                : f.v}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
